pkgname=brscan-skey
pkgver=0.3.5_0
pkgrel=1
pkgdesc='Brother Linux scanner S-KEY tool'
arch=('x86_64')
license=('custom:Brother')
url='https://support.brother.com'
depends=('bash' 'brscan5' 'curl' 'glibc')
optdepends=(
  'evince: viewer for scan-to-image'
  'okular: viewer for scan-to-image'
  'xreader: viewer for scan-to-image'
  'libreoffice-fresh: viewer for scan-to-image'
  'atril: viewer for scan-to-image'
  'eom: viewer for scan-to-image'
  'gimp: fallback viewer for scan-to-image'
)
backup=(
  'opt/brother/scanner/brscan-skey/brscan_mail.config'
  'opt/brother/scanner/brscan-skey/brscan-skey.config'
  'opt/brother/scanner/brscan-skey/brscan-snmp.cfg'
  'opt/brother/scanner/brscan-skey/scantofile.config'
  'opt/brother/scanner/brscan-skey/scantoimage.config'
  'opt/brother/scanner/brscan-skey/scantoocr.config'
  'opt/brother/scanner/brscan-skey/scantoemail.config'
)
options=('!strip')
install='brscan-skey.install'
source=("${pkgname}-${pkgver/_/-}.amd64.deb")
noextract=("${pkgname}-${pkgver/_/-}.amd64.deb")
sha256sums=('cda25534ea8e3018e7d46b970cb08b36084355adedc933aba0c8c7d03e903db9')

prepare() {
  bsdtar -Oxf "${srcdir}/${pkgname}-${pkgver/_/-}.amd64.deb" data.tar.xz |
    bsdtar -xf - -C "${srcdir}"
}

package() {
  local conf_dir="${pkgdir}/etc/opt/brother/scanner/brscan-skey"
  local confs=(
    brscan_mail.config
    brscan-skey.config
    brscan-snmp.cfg
    scantofile.config
    scantoimage.config
    scantoocr.config
    scantoemail.config
  )
  local conf

  cp -a "${srcdir}/opt" "${pkgdir}/"

  install -d "${conf_dir}" "${pkgdir}/usr/bin"
  for conf in "${confs[@]}"; do
    ln -sf "/opt/brother/scanner/brscan-skey/${conf}" "${conf_dir}/${conf}"
  done
  ln -sf '/opt/brother/scanner/brscan-skey/brscan-skey' "${pkgdir}/usr/bin/brscan-skey"

  install -D -m644 "${srcdir}/opt/brother/scanner/brscan-skey/LICENSE_ENG.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE_ENG.txt"
  install -D -m644 "${srcdir}/opt/brother/scanner/brscan-skey/LICENSE_JPN.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE_JPN.txt"

  chown -R root:root "${pkgdir}/etc" "${pkgdir}/opt" "${pkgdir}/usr"
  chmod -R u+rwX,go+rX,go-w "${pkgdir}/etc" "${pkgdir}/opt" "${pkgdir}/usr"
}
