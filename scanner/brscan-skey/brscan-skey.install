post_install() {
  /opt/brother/scanner/brscan-skey/mk_mailmessage.sh i >/dev/null 2>&1 || true

  cat <<'EOF'
To start the Brother scan-key listener, run:
  brscan-skey

To list registered scanner targets, run:
  brscan-skey -l
EOF
}

post_upgrade() {
  post_install
}

pre_remove() {
  /opt/brother/scanner/brscan-skey/mk_mailmessage.sh r >/dev/null 2>&1 || true
}
