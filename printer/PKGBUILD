# Maintainer: Miroslav Pavleski <miroslav@pavleski.net>
# Contributor: Bernhard Jaud <itsme+aur at genuineparts dot org>
# This uses modified code from package brother-mfc-9335cdn by Leo Pham <regretfulumbrella at gmail dot com>
_model=mfcl3760cdw

pkgname=brother-mfc-l3760cdw
pkgver=3.5.1
pkgrel=4
pkgdesc='LPR and CUPS drivers for the Brother MFC-L3760CDW'
arch=('x86_64')
url='https://support.brother.com/g/s/id/linux/en/index.html'
license=('custom:Brother' 'GPL')
depends=('cups' 'file' 'gcc-libs' 'ghostscript' 'glibc' 'perl' 'which')
options=('!strip' '!debug')
install='brother-mfc-l3760cdw.install'
backup=("opt/brother/Printers/${_model}/inf/br${_model}rc")
source=(
  "${_model}pdrv-${pkgver}-1.i386.deb"
  'cupswrappermfcl3760cdw.patch'
  'setupPrintcapij.patch'
)
noextract=("${_model}pdrv-${pkgver}-1.i386.deb")
sha256sums=(
  '9642d01d9b8b13d434082ca282aefb29783f34d2db60406775bc605bd3c9a828'
  '13d83b7198a6dfa6e3e0d547bc145f2b9d7b777245a91964a153000db1a6d05b'
  'c9ab44ca0d2ac04f427e475d878cf537c8f2b05119f89dc1551315721dc6d0cb'
)

prepare() {
  bsdtar -Oxf "${srcdir}/${_model}pdrv-${pkgver}-1.i386.deb" data.tar.gz |
    bsdtar -xf - -C "${srcdir}"

  patch -d "${srcdir}/opt/brother/Printers/${_model}/inf" \
    -Np0 -i "${srcdir}/setupPrintcapij.patch"
  patch -d "${srcdir}/opt/brother/Printers/${_model}/cupswrapper" \
    -Np0 -i "${srcdir}/cupswrappermfcl3760cdw.patch"

  perl -i -pe 's#printcap\.local#printcap#g' \
    "${srcdir}/opt/brother/Printers/${_model}/inf/setupPrintcapij"
}

package() {
  local printer_dir="${pkgdir}/opt/brother/Printers/${_model}"

  cp -a "${srcdir}/opt" "${pkgdir}/"

  rm -rf "${printer_dir}/lpd/i686"
  ln -sf "x86_64/br${_model}filter" "${printer_dir}/lpd/br${_model}filter"
  ln -sf "x86_64/brprintconf_${_model}" "${printer_dir}/lpd/brprintconf_${_model}"

  install -d \
    "${pkgdir}/usr/bin" \
    "${pkgdir}/usr/lib/cups/filter" \
    "${pkgdir}/usr/share/cups/model" \
    "${pkgdir}/usr/share/ppd/Brother"

  ln -sf "/opt/brother/Printers/${_model}/lpd/brprintconf_${_model}" \
    "${pkgdir}/usr/bin/brprintconf_${_model}"
  ln -sf "/opt/brother/Printers/${_model}/cupswrapper/brother_lpdwrapper_${_model}" \
    "${pkgdir}/usr/lib/cups/filter/brother_lpdwrapper_${_model}"
  ln -sf "/opt/brother/Printers/${_model}/cupswrapper/brother_${_model}_printer_en.ppd" \
    "${pkgdir}/usr/share/cups/model/brother_${_model}_printer_en.ppd"
  ln -sf "/opt/brother/Printers/${_model}/cupswrapper/brother_${_model}_printer_en.ppd" \
    "${pkgdir}/usr/share/ppd/Brother/brother_${_model}_printer_en.ppd"

  install -D -m644 "${srcdir}/opt/brother/Printers/${_model}/LICENSE_ENG.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE_ENG.txt"
  install -D -m644 "${srcdir}/opt/brother/Printers/${_model}/LICENSE_JPN.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE_JPN.txt"

  chown -R root:root "${pkgdir}/opt" "${pkgdir}/usr"
  find "${pkgdir}/opt" "${pkgdir}/usr" -type d -exec chmod 755 {} +
  find "${pkgdir}/opt" "${pkgdir}/usr" -type f -exec chmod 644 {} +
  chmod 755 \
    "${printer_dir}/cupswrapper/cupswrapper${_model}" \
    "${printer_dir}/cupswrapper/brother_lpdwrapper_${_model}" \
    "${printer_dir}/inf/setupPrintcapij" \
    "${printer_dir}/lpd/filter_${_model}" \
    "${printer_dir}/lpd/x86_64/br${_model}filter" \
    "${printer_dir}/lpd/x86_64/brprintconf_${_model}"
}
